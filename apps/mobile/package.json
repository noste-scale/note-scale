{
  "name": "@notescale/mobile",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "vite-node scripts/self-check.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "lint": "eslint app src scripts",
    "export": "expo export --platform android --output-dir dist/android && expo export --platform ios --output-dir dist/ios"
  },
  "dependencies": {
    "@notescale/music": "*",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~58.0.23",
    "expo-audio": "~58.0.11",
    "expo-constants": "~58.0.15",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "vite-node": "3.2.4"
  }
}
