{
  "name": "notescale",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Learn to construct major scales on web and mobile.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "generate:audio": "node --experimental-strip-types scripts/generate-audio.ts",
    "verify:audio": "node --experimental-strip-types scripts/verify-audio.ts",
    "verify:web-build": "node --experimental-strip-types scripts/verify-web-build.ts",
    "start:web": "npm run dev --workspace @notescale/web --",
    "dev:web": "npm run dev --workspace @notescale/web --",
    "preview:web": "npm run preview --workspace @notescale/web --",
    "start:mobile": "npm run start --workspace @notescale/mobile",
    "android": "npm run android --workspace @notescale/mobile",
    "ios": "npm run ios --workspace @notescale/mobile",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.scripts.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint scripts && npm run lint --workspaces --if-present",
    "build": "npm run build --workspace @notescale/web"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.15.30",
    "eslint": "10.8.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.67.0"
  }
}
